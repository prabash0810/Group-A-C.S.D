/* DayWise Settings Page
   Theme and settings styling */

/* Basic reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

/* Main theme variables */
:root {
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --border-color: #e2e8f0;
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --shadow-color: rgba(15, 23, 42, 0.08);
}

/* Default DayWise theme */
body.theme-default {
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --border-color: #e2e8f0;
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --shadow-color: rgba(15, 23, 42, 0.08);
}

/* Dark theme */
body.theme-dark {
    --bg-main: #020617;
    --bg-card: #0f172a;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --border-color: #334155;
    --primary-color: #60a5fa;
    --primary-hover: #3b82f6;
    --shadow-color: rgba(0, 0, 0, 0.35);
}

/* Light theme */
body.theme-light {
    --bg-main: #ffffff;
    --bg-card: #ffffff;
    --text-main: #1e293b;
    --text-muted: #64748b;
    --border-color: #cbd5e1;
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --shadow-color: rgba(15, 23, 42, 0.06);
}

/* Page styling */
body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg-main);
    color: var(--text-main);
    min-height: 100vh;
    transition: background 0.3s ease, color 0.3s ease;
}

/* Settings page container */
.settings-page {
    min-height: 100vh;
    padding: 40px 8%;
}

/* Settings heading area */
.settings-header {
    max-width: 1100px;
    margin: 0 auto 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.settings-header h1 {
    color: var(--text-main);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -1px;
}

.settings-header p {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 0.95rem;
}

/* Back button */
.back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 11px 18px;
    border-radius: 12px;
    background: var(--primary-color);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 7px 18px var(--shadow-color);
    transition: all 0.25s ease;
}

.back-btn:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
}

/* Settings cards */
.settings-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    gap: 22px;
}

.settings-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 12px 30px var(--shadow-color);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.settings-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 38px var(--shadow-color);
}

/* Card headings */
.settings-card-header {
    margin-bottom: 22px;
}

.settings-card-header h2 {
    color: var(--text-main);
    font-size: 1.3rem;
    font-weight: 700;
}

.settings-card-header p {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* Individual setting rows */
.setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
}

.setting-row h3 {
    color: var(--text-main);
    font-size: 0.98rem;
    font-weight: 600;
}

.setting-row p {
    margin-top: 5px;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
}

/* Small setting buttons */
.setting-btn {
    padding: 10px 17px;
    border-radius: 10px;
    background: #eff6ff;
    color: var(--primary-color);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    transition: all 0.25s ease;
}

.setting-btn:hover {
    background: #dbeafe;
    transform: translateY(-2px);
}

/* Theme selection area */
.theme-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 18px;
}

/* Individual theme option */
.theme-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 18px;
    border: 1px solid var(--border-color);
    border-radius: 18px;
    background: var(--bg-card);
    color: var(--text-main);
    cursor: pointer;
    transition: all 0.25s ease;
}

.theme-option:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px var(--shadow-color);
}

/* Shows which theme is currently selected */
.theme-option.active {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

/* Theme preview boxes */
.theme-preview {
    width: 100%;
    height: 70px;
    border-radius: 12px;
    border: 1px solid var(--border-color);
}

/* Preview for default theme */
.default-preview {
    background: linear-gradient(135deg, #f8fafc, #dbeafe);
}

/* Preview for dark theme */
.dark-preview {
    background: linear-gradient(135deg, #020617, #1e293b);
}

/* Preview for light theme */
.light-preview {
    background: #ffffff;
}

/* Mobile layout */
@media (max-width: 700px) {
    .settings-page {
        padding: 30px 5%;
    }

    .settings-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .theme-options {
        grid-template-columns: 1fr;
    }

    .setting-row {
        flex-direction: column;
        align-items: flex-start;
    }

    .setting-btn {
        width: 100%;
        text-align: center;
    }
}

/* Smaller phone screens */
@media (max-width: 450px) {
    .settings-page {
        padding: 25px 4%;
    }

    .settings-card {
        padding: 20px;
        border-radius: 20px;
    }

    .settings-header h1 {
        font-size: 2rem;
    }
}