/* =========================================================
   DayWise Settings Page
   ========================================================= */

/* -------------------------
   Theme Colours
   ------------------------- */

:root {
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --border-color: #e2e8f0;
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --shadow-color: rgba(15, 23, 42, 0.08);
}

/* Default Theme */
body.theme-default {
    --bg-main: #f8fafc;
    --bg-card: #ffffff;
    --text-main: #0f172a;
    --text-muted: #64748b;
    --border-color: #e2e8f0;
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --shadow-color: rgba(15, 23, 42, 0.08);
}

/* Dark Theme */
body.theme-dark {
    --bg-main: #020617;
    --bg-card: #0f172a;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --border-color: #334155;
    --primary-color: #60a5fa;
    --primary-hover: #3b82f6;
    --shadow-color: rgba(0, 0, 0, 0.35);
}

/* Light Theme */
body.theme-light {
    --bg-main: #ffffff;
    --bg-card: #ffffff;
    --text-main: #1e293b;
    --text-muted: #64748b;
    --border-color: #cbd5e1;
    --primary-color: #2563eb;
    --primary-hover: #1d4ed8;
    --shadow-color: rgba(15, 23, 42, 0.06);
}


/* -------------------------
   Global Reset
   ------------------------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg-main);
    color: var(--text-main);
    min-height: 100vh;
    overflow-x: hidden;
    transition:
        background 0.3s ease,
        color 0.3s ease;
}


/* -------------------------
   Main Settings Area
   ------------------------- */

.settings-page {
    min-height: 100vh;
    padding: 40px 8%;
}


/* -------------------------
   Settings Header
   ------------------------- */

.settings-header {
    max-width: 1100px;
    margin: 0 auto 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.settings-header h1 {
    color: var(--text-main);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -1px;
}

.settings-header p {
    margin-top: 8px;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
}


/* -------------------------
   Back To Dashboard
   ------------------------- */

.back-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 11px 20px;
    border-radius: 12px;
    background: var(--primary-color);
    color: #ffffff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 7px 18px rgba(37, 99, 235, 0.2);

    transition:
        transform 0.25s ease,
        background 0.25s ease,
        box-shadow 0.25s ease;
}

.back-btn:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 10px 24px rgba(37, 99, 235, 0.28);
}

.back-btn:active {
    transform: translateY(0);
}


/* -------------------------
   Settings Container
   ------------------------- */

.settings-container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    gap: 22px;
}


/* -------------------------
   Settings Cards
   ------------------------- */

.settings-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 24px;
    padding: 28px;
    overflow: hidden;

    box-shadow: 0 12px 30px var(--shadow-color);

    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        border-color 0.3s ease;
}

.settings-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: var(--primary-color);
    opacity: 0;
    transition: opacity 0.3s ease;
}

.settings-card:hover {
    transform: translateY(-4px);
    border-color: rgba(37, 99, 235, 0.25);
    box-shadow: 0 18px 40px var(--shadow-color);
}

.settings-card:hover::before {
    opacity: 1;
}


/* -------------------------
   Card Header
   ------------------------- */

.settings-card-header {
    margin-bottom: 22px;
}

.settings-card-header h2 {
    color: var(--text-main);
    font-size: 1.3rem;
    font-weight: 700;
}

.settings-card-header p {
    margin-top: 6px;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
}


/* -------------------------
   Individual Setting Rows
   ------------------------- */

.setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0 0;
    margin-top: 20px;
    border-top: 1px solid var(--border-color);
}

.setting-row:first-child {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
}

.setting-row h3 {
    color: var(--text-main);
    font-size: 0.98rem;
    font-weight: 600;
}

.setting-row p {
    margin-top: 5px;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
}


/* -------------------------
   Setting Buttons
   ------------------------- */

.setting-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 17px;
    border: 1px solid rgba(37, 99, 235, 0.12);
    border-radius: 10px;
    background: rgba(37, 99, 235, 0.1);
    color: var(--primary-color);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;

    transition:
        background 0.25s ease,
        transform 0.25s ease,
        border-color 0.25s ease;
}

.setting-btn:hover {
    background: rgba(37, 99, 235, 0.16);
    border-color: rgba(37, 99, 235, 0.25);
    transform: translateY(-2px);
}

.setting-btn:active {
    transform: translateY(0);
}


/* -------------------------
   Theme Options
   ------------------------- */

.theme-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

.theme-option {
    padding: 18px;
    border: 1px solid var(--border-color);
    border-radius: 16px;
    background: var(--bg-card);
    color: var(--text-main);
    cursor: pointer;

    transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease,
        background 0.25s ease;
}

.theme-option:hover {
    transform: translateY(-3px);
    border-color: var(--primary-color);
    box-shadow: 0 8px 20px var(--shadow-color);
}

.theme-option.active {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.1);
}

.theme-option h3 {
    color: var(--text-main);
    font-size: 0.95rem;
    font-weight: 600;
}

.theme-option p {
    margin-top: 5px;
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.4;
}


/* -------------------------
   Inputs / Selects
   ------------------------- */

.settings-card input,
.settings-card select {
    width: 100%;
    padding: 11px 13px;
    border: 1px solid var(--border-color);
    border-radius: 10px;
    background: var(--bg-main);
    color: var(--text-main);
    font-family: inherit;
    font-size: 0.9rem;
    outline: none;

    transition:
        border-color 0.25s ease,
        box-shadow 0.25s ease;
}

.settings-card input:focus,
.settings-card select:focus {
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}


/* -------------------------
   Checkbox / Toggle Support
   ------------------------- */

.settings-card input[type="checkbox"] {
    width: auto;
    accent-color: var(--primary-color);
    cursor: pointer;
}


/* -------------------------
   Success / Status Messages
   ------------------------- */

.settings-message {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgba(22, 163, 74, 0.1);
    color: #16a34a;
    font-size: 0.85rem;
}


/* -------------------------
   Tablet
   ------------------------- */

@media (max-width: 800px) {

    .settings-page {
        padding: 35px 6%;
    }

    .settings-header {
        align-items: flex-start;
    }

    .theme-options {
        grid-template-columns: repeat(2, 1fr);
    }
}


/* -------------------------
   Mobile
   ------------------------- */

@media (max-width: 700px) {

    .settings-page {
        padding: 30px 6%;
    }

    .settings-header {
        flex-direction: column;
        align-items: flex-start;
        margin-bottom: 28px;
    }

    .settings-header h1 {
        font-size: 2.1rem;
    }

    .back-btn {
        width: 100%;
    }

    .settings-card {
        padding: 22px;
        border-radius: 20px;
    }

    .setting-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 14px;
    }

    .setting-btn {
        width: 100%;
        text-align: center;
    }

    .theme-options {
        grid-template-columns: 1fr;
    }
}


/* -------------------------
   Small Mobile
   ------------------------- */

@media (max-width: 450px) {

    .settings-page {
        padding: 25px 5%;
    }

    .settings-card {
        padding: 20px;
        border-radius: 18px;
    }

    .settings-header h1 {
        font-size: 2rem;
    }

    .settings-header p {
        font-size: 0.88rem;
    }

    .theme-option {
        padding: 15px;
    }
}


/* -------------------------
   Reduced Motion
   ------------------------- */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior: auto !important;
        transition: none !important;
        animation: none !important;
    }
}